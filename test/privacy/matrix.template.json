    "baseline_no_overlay",
    "passwisely",
    "systemcontainer"
  ],
  "dimensions": [
    "window_share",
    "display_share",
    "application_share",
    "tab_share",
    "local_recording",
    "platform_recording",
    "focus",
    "system_identity"
  ],
