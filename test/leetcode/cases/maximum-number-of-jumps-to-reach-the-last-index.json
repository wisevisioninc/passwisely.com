  "statement": "从整数数组nums的下标0出发，每次只能跳到更大的下标j；若当前在i，需满足abs(nums[j]-nums[i])≤target。求到达末尾下标的最多跳跃次数，不可达返回-1。目标是最多而非最少。约束：2≤长度≤1000，-10^9≤nums[i]≤10^9，0≤target≤2×10^9。",
  "python": {
    "method": "maximumJumps",
    "params": [
      {
        "name": "nums",
        "type": "integer[]"
      },
      {
        "type": "integer",
        "name": "target"
      }
    ],
    "return": {
      "type": "integer"
    },
    "template": "class Solution:\n    def maximumJumps(self, nums: List[int], target: int) -> int:\n        "
  },
  "compare": "exact",
  "cases": [
    {
      "name": "equal-pair-zero-target",
      "args": [
        [
          4,
          4
        ],
        0
      ],
      "expected": 1,
      "kind": "boundary"
    },
    {
      "name": "unequal-pair-zero-target",
      "args": [
        [
          4,
          5
        ],
        0
      ],
      "expected": -1,
      "kind": "boundary"
    },
    {
      "name": "skip-unreachable-middle",
      "args": [
        [
          0,
          100,
          1
        ],
        1
      ],
      "expected": 1,
      "kind": "normal"
    },
    {
      "name": "maximize-not-minimize",
      "args": [
        [
          0,
          2,
          1,
          3
        ],
        2
      ],
      "expected": 3,
      "kind": "normal"
    },
    {
      "name": "jump-among-equal-values",
      "args": [
        [
          2,
          8,
          2,
          8,
          2
        ],
        0
      ],
      "expected": 2,
      "kind": "normal"
    },
    {
      "name": "largest-allowed-difference",
      "args": [
        [
          -1000000000,
          1000000000
        ],
        2000000000
      ],
      "expected": 1,
      "kind": "boundary"
    },
    {
      "name": "best-path-starts-by-skipping",
      "args": [
        [
          5,
          1,
          4,
          2,
          3
        ],
        2
      ],
      "expected": 3,
      "kind": "normal"
    },
    {
      "name": "only-direct-last-jump",
      "args": [
        [
          0,
          5,
          10,
          0
        ],
        4
      ],
      "expected": 1,
      "kind": "normal"
    },
    {
      "name": "equality-at-threshold",
      "args": [
        [
          0,
          10,
          20
        ],
        10
      ],
      "expected": 2,
      "kind": "boundary"
    }
  ]
