# Canonical public HTTPS origin for payment notifications/returns, password
# recovery links and site health checks. No path/query/fragment or HTTP origins.
# Omit to use https://passwisely.cn; an explicitly blank value is invalid.
PUBLIC_SITE_URL=https://passwisely.cn

# Server-only Alipay computer website payment (alipay.trade.page.pay), RSA2
# public-key mode: application PKCS#8 private key + Alipay SPKI public key.
# Complete merchant/product approval before live checkout. Never send keys in chat.
ALIPAY_APP_ID=
# Alipay merchant PID (2088... UID); signed notify seller_id must match.
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do

# WeChat Native API v3: configure your explicit merchant number and its bound
# AppID. API v3 key is exactly 32 bytes; merchant certificate serial must match
# its private key. WeChat Pay public key/ID are separate from merchant keys.
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=

RELEASE_UPLOAD_KEY=

# Supabase account, sessions, credits, and purchase storage.
# Keep the secret/service-role key server-side only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy key names are supported while Supabase projects transition key formats.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Default keys used only by the authenticated Wise AI relay. Users who send
# their own provider key are not charged credits.
# The admin console stores the active default provider, model, and encrypted
# key in Supabase. These values remain as a safe fallback during DB outages.
AI_DEFAULT_PROVIDER=kimi
AI_DEFAULT_MODEL=kimi-k3.1-pro
OPENAI_API_KEY=
# Applies only to the server-owned OpenAI key; personal keys remain official.
# Use https://wisepa.cn/v1 for the WisePA gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
DASHSCOPE_API_KEY=
# Legacy alias supported for existing deployments.
QWEN_API_KEY=
TAVILY_API_KEY=

# Server-only Recall Desktop SDK upload-token creation (never expose in VITE_*).
# Region must match the Recall workspace: us-west-2, us-east-1,
# eu-central-1, or ap-northeast-1. RECALLAI_API_KEY is a legacy key alias.
RECALL_API_KEY=
RECALL_API_REGION=us-west-2

# Admin dashboard (https://admin.passwisely.com). All three values are required
# in production; ADMIN_SESSION_SECRET should be a long random value.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_BASE_URL=https://admin.passwisely.com

# Intel macOS native capture: server-only temporary Deepgram JWT broker.
# Grant API requires a Member/Admin/Owner key; do not put this in client env.
# Recall ASR separately needs credentials registered in its own dashboard.
DEEPGRAM_API_KEY=
