# Optional managed-deployment configuration. The desktop settings UI can
# configure these values securely without a .env file.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_SUPPORTS_VISION=true
# zh-CN (default) or en
AI_RESPONSE_LANGUAGE=zh-CN
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Other supported provider keys (set only the one you use):
DEEPSEEK_API_KEY=
KIMI_API_KEY=
DOUBAO_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional generic update feed containing latest.yml/latest-mac.yml artifacts.
PASSWISELY_UPDATE_URL=
# Account, purchase, and credit API. Defaults to https://passwisely.com/api.
PASSWISELY_API_URL=https://passwisely.com/api
